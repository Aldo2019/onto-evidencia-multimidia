digraph OEM_Core {
    graph [rankdir=TB, fontname="Arial", fontsize=13.46, bgcolor="white", color="black",
           size="6.28,11.0!", margin="0.01", pad="0.01",
           nodesep="0.10", ranksep="0.22", splines=true, overlap=false, newrank=true];
    node [shape=box, style="rounded,filled", fillcolor="#F7F7F7", color="#1A1A1A",
          fontname="Arial", fontsize=13.2, margin="0.035,0.02", height=0.25];
    edge [fontname="Arial", fontsize=12.41, color="#1A1A1A", fontcolor="#111111"];

    subgraph cluster_evidencia {
        label="Evidência (unidade documentária)";
        labelloc="t";
        style="rounded,dashed"; color="#555555"; fontcolor="#111111"; fontsize=13.46; margin=8;
        EvidenciaComCadeiaQuebrada [label="Evidência com\nCadeia de\nCustódia\nQuebrada\n(≡)", peripheries=2, fillcolor="#E6E6E6", penwidth=1.2];
        EvidenciaIntegra [label="Evidência\nÍntegra\n(≡)", peripheries=2, fillcolor="#E6E6E6", penwidth=1.2];
        EvidenciaComConteudoAlterado [label="Evidência com\nConteúdo\nAlterado\n(≡)", peripheries=2, fillcolor="#E6E6E6", penwidth=1.2];
        EvidenciaMultimidia [label="Evidência\nMultimídia", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        { rank=same; EvidenciaComCadeiaQuebrada; EvidenciaIntegra; EvidenciaComConteudoAlterado; }
        EvidenciaComCadeiaQuebrada -> EvidenciaIntegra -> EvidenciaComConteudoAlterado [style=invis, weight=10];
    }

    subgraph cluster_transformacoes {
        label="Transformações";
        labelloc="t";
        style="rounded,dashed"; color="#555555"; fontcolor="#111111"; fontsize=13.46; margin=8;
        Transformacao [label="Transformação", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        TransformacaoPreservadora [label="Transformação\nPreservadora\n(≡)", peripheries=2, fillcolor="#E6E6E6", penwidth=1.2];
        TransformacaoIsomorfica [label="Transformação\nIsomórfica", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        TransformacaoHomomorfica [label="Transformação\nHomomórfica", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        TransformacaoGenerativa [label="Transformação\nGenerativa", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        TransformacaoDeclarada [label="Transformação\nDeclarada\n(≡)", peripheries=2, fillcolor="#E6E6E6", penwidth=1.2];
        TransformacaoNaoDeclarada [label="Transformação\nNão Declarada\n(≡)", peripheries=2, fillcolor="#E6E6E6", penwidth=1.2];
        TransformacaoPreservadoraDeclarada [label="Transformação\nPreservadora\nDeclarada\n(≡)", peripheries=2, fillcolor="#E6E6E6", penwidth=1.2];
    }

    subgraph cluster_custodia {
        label="Custódia";
        labelloc="t";
        style="rounded,dashed"; color="#555555"; fontcolor="#111111"; fontsize=13.46; margin=8;
        RegistroDeCustodia [label="Registro de\nCustódia", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        ValorHash [label="Valor de Hash", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        Agente [label="Agente", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
    }

    subgraph cluster_exame_achado {
        label="Exame e achado (conteúdo)";
        labelloc="t";
        style="rounded,dashed"; color="#555555"; fontcolor="#111111"; fontsize=13.46; margin=8;
        ExamePericial [label="Exame Pericial", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        AchadoPericial [label="Achado\nPericial", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        IndicioDeEdicao [label="Indício de\nEdição", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        DescontinuidadeENF [label="Descontinuidade\nde ENF", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
        IndicioDeRecodificacao [label="Indício de\nRecodificação", peripheries=1, fillcolor="#FAFAFA", penwidth=1.0];
    }

    // 2x2 Cluster Grid: Top = (Exame_achado | Evidencia), Bottom = (Transformacoes | Custodia)
    { rank=same; DescontinuidadeENF; IndicioDeRecodificacao; EvidenciaComCadeiaQuebrada; EvidenciaIntegra; EvidenciaComConteudoAlterado; }
    { rank=same; AchadoPericial; EvidenciaMultimidia; }
    AchadoPericial -> TransformacaoIsomorfica [style=invis, weight=8];
    AchadoPericial -> TransformacaoHomomorfica [style=invis, weight=8];
    EvidenciaMultimidia -> TransformacaoPreservadoraDeclarada [style=invis, weight=4];

    // 1. Subclass edges (solid with hollow normal arrowhead)
    DescontinuidadeENF -> IndicioDeEdicao [arrowhead=onormal, style=solid, weight=3];
    EvidenciaComCadeiaQuebrada -> EvidenciaMultimidia [arrowhead=onormal, style=solid, weight=3];
    EvidenciaComConteudoAlterado -> EvidenciaMultimidia [arrowhead=onormal, style=solid, weight=3];
    EvidenciaIntegra -> EvidenciaMultimidia [arrowhead=onormal, style=solid, weight=3];
    ExamePericial -> TransformacaoHomomorfica [arrowhead=onormal, style=solid, weight=3];
    IndicioDeEdicao -> AchadoPericial [arrowhead=onormal, style=solid, weight=3];
    IndicioDeRecodificacao -> IndicioDeEdicao [arrowhead=onormal, style=solid, weight=3];
    TransformacaoDeclarada -> Transformacao [arrowhead=onormal, style=solid, weight=3];
    TransformacaoGenerativa -> Transformacao [arrowhead=onormal, style=solid, weight=3];
    TransformacaoHomomorfica -> TransformacaoPreservadora [arrowhead=onormal, style=solid, weight=3];
    TransformacaoIsomorfica -> TransformacaoPreservadora [arrowhead=onormal, style=solid, weight=3];
    TransformacaoNaoDeclarada -> Transformacao [arrowhead=onormal, style=solid, weight=3];
    TransformacaoPreservadora -> Transformacao [arrowhead=onormal, style=solid, weight=3];
    TransformacaoPreservadoraDeclarada -> TransformacaoDeclarada [arrowhead=onormal, style=solid, weight=3];
    TransformacaoPreservadoraDeclarada -> TransformacaoPreservadora [arrowhead=onormal, style=solid, weight=3];

    // 2. Object property edges (dashed with normal arrowhead)
    RegistroDeCustodia -> Agente [style=dashed, arrowhead=normal, label="  atestadoPor  ", minlen=2, weight=4];
    ExamePericial -> AchadoPericial [style=dashed, arrowhead=normal, label=" geraAchado ", weight=1];
    Transformacao -> RegistroDeCustodia [style=dashed, arrowhead=normal, label=" registradaEm\n(inv. documentaTransformacao) ", weight=1];
    EvidenciaMultimidia -> Transformacao [style=dashed, arrowhead=normal, label=" sofreu\n(inv. temSaida) ", weight=2];
    Transformacao -> EvidenciaMultimidia [style=dashed, arrowhead=normal, headlabel="temEntrada  ", labeldistance=2.6, labelangle=32, weight=2];
    Transformacao -> ValorHash [style=dashed, arrowhead=normal, label=" verificadaPor ", weight=1];

    // 3. Disjointness edges (short horizontal segments between adjacent nodes, never crossing cluster title)
    EvidenciaComCadeiaQuebrada:e -> EvidenciaIntegra:w [style=dotted, dir=none, label=" disjuntas ", weight=5, constraint=false, penwidth=1.4];
    EvidenciaIntegra:e -> EvidenciaComConteudoAlterado:w [style=dotted, dir=none, label=" disjuntas ", weight=5, constraint=false, penwidth=1.4];
}
