@prefix : <http://example.org/oem#> .
@prefix oem: <http://example.org/oem#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@base <http://example.org/oem> .

<http://example.org/oem> rdf:type owl:Ontology ;
                          rdfs:label "Ontologia de Evidências Multimídia (OEM)"@pt ,
                                     "Ontology of Multimedia Evidence (OEM)"@en ;
                          skos:definition "OWL 2 DL ontology for representing chain of custody, isomorphic, homomorphic, and generative transformations, and formal integrity assessment of multimedia evidence under the Open World Assumption (OWA)."@en ,
                                          "Ontologia OWL 2 DL para representação da cadeia de custódia, transformações isomórficas, homomórficas e generativas, e avaliação formal de integridade de evidências multimídia sob pressuposição de mundo aberto (OWA)."@pt .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/oem#atestadoPor
oem:atestadoPor rdf:type owl:ObjectProperty ;
                rdfs:domain oem:RegistroDeCustodia ;
                rdfs:range oem:Agente ;
                rdfs:label "atestado por"@pt ,
                           "attested by"@en ;
                skos:definition "Indica o agente responsável que assina ou atesta o registro na cadeia de custódia."@pt ,
                                "Indicates the responsible agent who signs or attests the record in the chain of custody."@en .


###  http://example.org/oem#comparadoComReferencia
oem:comparadoComReferencia rdf:type owl:ObjectProperty ;
                           rdfs:domain oem:ExamePericial ;
                           rdfs:range oem:EvidenciaMultimidia ;
                           rdfs:label "comparado com referência"@pt ,
                                      "compared with reference"@en ;
                           skos:definition "Indica a evidência original usada como padrão de comparação em um exame pericial."@pt ,
                                           "Indicates the original evidence used as a comparison baseline in a forensic examination."@en .


###  http://example.org/oem#documentaTransformacao
oem:documentaTransformacao rdf:type owl:ObjectProperty ;
                           owl:inverseOf oem:registradaEm ;
                           rdfs:domain oem:RegistroDeCustodia ;
                           rdfs:range oem:Transformacao ;
                           rdfs:label "documenta transformação"@pt ,
                                      "documents transformation"@en ;
                           skos:definition "Links a custody record to the technical transformation it documents."@en ,
                                           "Vincula um registro de custódia à transformação técnica por ele documentada."@pt .


###  http://example.org/oem#geraAchado
oem:geraAchado rdf:type owl:ObjectProperty ;
               rdfs:domain oem:ExamePericial ;
               rdfs:range oem:AchadoPericial ;
               rdfs:label "generates finding"@en ,
                          "gera achado"@pt ;
               skos:definition "Relaciona um exame pericial a um achado ou indício técnico nele observado."@pt ,
                               "Relates a forensic examination to a technical finding or indicator observed therein."@en .


###  http://example.org/oem#registradaEm
oem:registradaEm rdf:type owl:ObjectProperty ;
                 rdfs:domain oem:Transformacao ;
                 rdfs:range oem:RegistroDeCustodia ;
                 rdfs:label "recorded in"@en ,
                            "registrada em"@pt ;
                 skos:definition "Links a transformation to its corresponding formal record in the chain of custody."@en ,
                                 "Vincula uma transformação ao seu respectivo registro formal na cadeia de custódia."@pt .


###  http://example.org/oem#sofreu
oem:sofreu rdf:type owl:ObjectProperty ;
           owl:inverseOf oem:temSaida ;
           rdfs:domain oem:EvidenciaMultimidia ;
           rdfs:range oem:Transformacao ;
           rdfs:label "sofreu transformação"@pt ,
                      "underwent transformation"@en ;
           skos:definition "Relaciona uma evidência multimídia a cada transformação pela qual ela passou até seu estado atual ou durante sua análise."@pt ,
                           "Relates multimedia evidence to each transformation it underwent up to its current state or during its analysis."@en .


###  http://example.org/oem#temEntrada
oem:temEntrada rdf:type owl:ObjectProperty ;
               rdfs:domain oem:Transformacao ;
               rdfs:range oem:EvidenciaMultimidia ;
               rdfs:label "has input"@en ,
                          "tem entrada"@pt ;
               skos:definition "Indica a evidência multimídia que serviu de insumo para uma transformação."@pt ,
                               "Indicates the multimedia evidence that served as input to a transformation."@en .


###  http://example.org/oem#temSaida
oem:temSaida rdf:type owl:ObjectProperty ;
             rdfs:domain oem:Transformacao ;
             rdfs:range oem:EvidenciaMultimidia ;
             rdfs:label "has output"@en ,
                        "tem saída"@pt ;
             skos:definition "Indica o artefato ou cópia resultante de uma transformação."@pt ,
                             "Indicates the artifact or copy resulting from a transformation."@en .


###  http://example.org/oem#temValorHash
oem:temValorHash rdf:type owl:ObjectProperty ;
                 rdfs:domain oem:EvidenciaMultimidia ;
                 rdfs:range oem:ValorHash ;
                 rdfs:label "has hash value"@en ,
                            "tem valor de hash"@pt ;
                 skos:definition "Associa uma evidência multimídia ao seu resumo criptográfico SHA-256."@pt ,
                                 "Associates multimedia evidence with its SHA-256 cryptographic digest."@en .


###  http://example.org/oem#verificadaPor
oem:verificadaPor rdf:type owl:ObjectProperty ;
                  rdfs:range oem:ValorHash ;
                  rdfs:label "verificada por"@pt ,
                             "verified by"@en ;
                  skos:definition "Associa uma transformação ou registro de custódia ao valor de hash criptográfico que garante a integridade do arquivo."@pt ,
                                  "Associates a transformation or custody record with the cryptographic hash value guaranteeing file integrity."@en .


#################################################################
#    Data properties
#################################################################

###  http://example.org/oem#algoritmoHash
oem:algoritmoHash rdf:type owl:DatatypeProperty ;
                  rdfs:domain oem:ValorHash ;
                  rdfs:range xsd:string ;
                  rdfs:label "algoritmo de hash"@pt ,
                             "hash algorithm"@en .


###  http://example.org/oem#caminhoArquivo
oem:caminhoArquivo rdf:type owl:DatatypeProperty ;
                   rdfs:domain oem:EvidenciaMultimidia ;
                   rdfs:range xsd:string ;
                   rdfs:label "caminho do arquivo"@pt ,
                              "file path"@en .


###  http://example.org/oem#comandoExecutado
oem:comandoExecutado rdf:type owl:DatatypeProperty ;
                     rdfs:domain oem:Transformacao ;
                     rdfs:range xsd:string ;
                     rdfs:label "comando executado"@pt ,
                                "executed command"@en .


###  http://example.org/oem#dataHora
oem:dataHora rdf:type owl:DatatypeProperty ;
             rdfs:range xsd:dateTime ;
             rdfs:label "data e hora"@pt ,
                        "date and time"@en .


###  http://example.org/oem#desvioPadraoFreqNormalizadoHz
oem:desvioPadraoFreqNormalizadoHz rdf:type owl:DatatypeProperty ;
                                  rdfs:domain oem:ExameENF ;
                                  rdfs:range xsd:decimal ;
                                  rdfs:label "desvio padrão de frequência normalizado (Hz)"@pt ,
                                             "normalized frequency standard deviation (Hz)"@en .


###  http://example.org/oem#estruturaGOPResumo
oem:estruturaGOPResumo rdf:type owl:DatatypeProperty ;
                       rdfs:domain oem:ExameMetadadosContainerGOP ;
                       rdfs:range xsd:string ;
                       rdfs:label "GOP structure summary"@en ,
                                  "resumo da estrutura de GOP"@pt .


###  http://example.org/oem#instanteSegundos
oem:instanteSegundos rdf:type owl:DatatypeProperty ;
                     rdfs:domain oem:DescontinuidadeENF ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "instant in seconds"@en ,
                                "instante em segundos"@pt .


###  http://example.org/oem#limiarSNR_dB
oem:limiarSNR_dB rdf:type owl:DatatypeProperty ;
                 rdfs:domain oem:ExameENF ;
                 rdfs:range xsd:decimal ;
                 rdfs:label "configured SNR threshold (dB)"@en ,
                            "limiar de SNR configurado (dB)"@pt .


###  http://example.org/oem#metodoDownmixMono
oem:metodoDownmixMono rdf:type owl:DatatypeProperty ;
                      rdfs:domain oem:Transformacao ;
                      rdfs:range xsd:string ;
                      rdfs:label "mono downmix method"@en ,
                                 "método de conversão para mono"@pt .


###  http://example.org/oem#nomeAgente
oem:nomeAgente rdf:type owl:DatatypeProperty ;
               rdfs:domain oem:Agente ;
               rdfs:range xsd:string ;
               rdfs:label "agent name"@en ,
                          "nome do agente"@pt .


###  http://example.org/oem#numeroCanais
oem:numeroCanais rdf:type owl:DatatypeProperty ;
                 rdfs:domain oem:EvidenciaMultimidia ;
                 rdfs:range xsd:integer ;
                 rdfs:label "number of channels"@en ,
                            "número de canais"@pt .


###  http://example.org/oem#parametrosTransformacao
oem:parametrosTransformacao rdf:type owl:DatatypeProperty ;
                            rdfs:domain oem:Transformacao ;
                            rdfs:range xsd:string ;
                            rdfs:label "parâmetros da transformação"@pt ,
                                       "transformation parameters"@en .


###  http://example.org/oem#resultadoExame
oem:resultadoExame rdf:type owl:DatatypeProperty ;
                   rdfs:domain oem:ExamePericial ;
                   rdfs:range xsd:string ;
                   rdfs:label "examination result"@en ,
                              "resultado do exame"@pt .


###  http://example.org/oem#snrMedio120Hz_dB
oem:snrMedio120Hz_dB rdf:type owl:DatatypeProperty ;
                     rdfs:domain oem:ExameENF ;
                     rdfs:range xsd:decimal ;
                     rdfs:label "SNR médio em 120 Hz (dB)"@pt ,
                                "mean SNR at 120 Hz (dB)"@en .


###  http://example.org/oem#snrMedio60Hz_dB
oem:snrMedio60Hz_dB rdf:type owl:DatatypeProperty ;
                    rdfs:domain oem:ExameENF ;
                    rdfs:range xsd:decimal ;
                    rdfs:label "SNR médio em 60 Hz (dB)"@pt ,
                               "mean SNR at 60 Hz (dB)"@en .


###  http://example.org/oem#somenteLeitura
oem:somenteLeitura rdf:type owl:DatatypeProperty ;
                   rdfs:domain oem:EvidenciaMultimidia ;
                   rdfs:range xsd:boolean ;
                   rdfs:label "read-only"@en ,
                              "somente leitura"@pt .


###  http://example.org/oem#tamanhoBytes
oem:tamanhoBytes rdf:type owl:DatatypeProperty ;
                 rdfs:domain oem:EvidenciaMultimidia ;
                 rdfs:range xsd:integer ;
                 rdfs:label "size in bytes"@en ,
                            "tamanho em bytes"@pt .


###  http://example.org/oem#taxaAmostragemHz
oem:taxaAmostragemHz rdf:type owl:DatatypeProperty ;
                     rdfs:domain oem:EvidenciaMultimidia ;
                     rdfs:range xsd:integer ;
                     rdfs:label "sample rate (Hz)"@en ,
                                "taxa de amostragem (Hz)"@pt .


###  http://example.org/oem#valorHashHex
oem:valorHashHex rdf:type owl:DatatypeProperty ;
                 rdfs:domain oem:ValorHash ;
                 rdfs:range xsd:string ;
                 rdfs:label "hexadecimal hash value"@en ,
                            "valor hexadecimal do hash"@pt .


###  http://example.org/oem#valorObservado
oem:valorObservado rdf:type owl:DatatypeProperty ;
                   rdfs:domain oem:AchadoPericial ;
                   rdfs:range xsd:string ;
                   rdfs:label "observed value"@en ,
                              "valor observado"@pt .


###  http://example.org/oem#valorReferencia
oem:valorReferencia rdf:type owl:DatatypeProperty ;
                    rdfs:domain oem:AchadoPericial ;
                    rdfs:range xsd:string ;
                    rdfs:label "reference value"@en ,
                               "valor na referência"@pt .


###  http://example.org/oem#versaoFerramenta
oem:versaoFerramenta rdf:type owl:DatatypeProperty ;
                     rdfs:domain oem:Transformacao ;
                     rdfs:range xsd:string ;
                     rdfs:label "tool version"@en ,
                                "versão da ferramenta"@pt .


#################################################################
#    Classes
#################################################################

###  http://example.org/oem#AchadoPericial
oem:AchadoPericial rdf:type owl:Class ;
                   rdfs:label "Achado Pericial"@pt ,
                              "Forensic Finding"@en ;
                   skos:definition "Elemento técnico objetivamente observado durante um exame pericial."@pt ,
                                   "Objective technical observation recorded during a forensic examination of multimedia evidence."@en ,
                                   "Observação técnica objetiva registrada durante um exame pericial em uma evidência multimídia."@pt ,
                                   "Technical element objectively observed during a forensic examination."@en .


###  http://example.org/oem#Agente
oem:Agente rdf:type owl:Class ;
           rdfs:label "Agent"@en ,
                      "Agente"@pt ;
           skos:definition "Forensic expert, analyst, or operator responsible for conducting and attesting acts in the chain of custody."@en ,
                           "Perito, analista ou operador responsável por conduzir e atestar atos na cadeia de custódia."@pt ,
                           "Person or system responsible for executing or attesting an act in the chain of custody."@en ,
                           "Pessoa ou sistema responsável por executar ou atestar um ato na cadeia de custódia."@pt .


###  http://example.org/oem#ArtefatoAnalitico
oem:ArtefatoAnalitico rdf:type owl:Class ;
                      rdfs:subClassOf oem:EvidenciaMultimidia ;
                      rdfs:label "Artefato Analítico Derivado"@pt ,
                                 "Derived Analytical Artifact"@en ;
                      skos:definition "Representação visual ou numérica (como um espectrograma ou curva de frequência) produzida por uma transformação homomórfica controlada."@pt ,
                                      "Representação visual ou numérica derivada de uma evidência multimídia por redução controlada (como um espectrograma ou curva de frequência)."@pt ,
                                      "Visual or numerical representation (such as a spectrogram or frequency curve) produced by a controlled homomorphic transformation."@en ,
                                      "Visual or numerical representation derived from multimedia evidence through controlled reduction (such as a spectrogram or frequency curve)."@en .


###  http://example.org/oem#DescontinuidadeENF
oem:DescontinuidadeENF rdf:type owl:Class ;
                       rdfs:subClassOf oem:IndicioDeEdicao ;
                       rdfs:label "Descontinuidade de ENF"@pt ,
                                  "ENF Discontinuity"@en ;
                       skos:definition "Abrupt shift in the power grid frequency captured in the recording, indicating a possible cut or insertion point in the audio."@en ,
                                       "Mudança brusca na frequência da rede elétrica captada na gravação, indicando possível ponto de corte ou inserção no áudio."@pt ,
                                       "Salto abrupto estatisticamente significativo na curva da frequência da rede elétrica (ENF) em um instante específico do áudio."@pt ,
                                       "Statistically significant abrupt jump in the Electrical Network Frequency (ENF) curve at a specific audio instant."@en .


###  http://example.org/oem#DivergenciaDeBitrate
oem:DivergenciaDeBitrate rdf:type owl:Class ;
                         rdfs:subClassOf oem:IndicioDeRecodificacao ;
                         rdfs:label "Bitrate Divergence"@en ,
                                    "Divergência de Taxa de Bits"@pt ;
                         skos:definition "Marked variation in the data rate per second (bitrate) of video or audio relative to the reference recording."@en ,
                                         "Variação acentuada no volume de dados por segundo (bitrate) do vídeo ou do áudio em relação à gravação de referência."@pt .


###  http://example.org/oem#DivergenciaDeEstruturaGOP
oem:DivergenciaDeEstruturaGOP rdf:type owl:Class ;
                              rdfs:subClassOf oem:IndicioDeRecodificacao ;
                              rdfs:label "Divergência de Estrutura de GOP"@pt ,
                                         "GOP Structure Divergence"@en ;
                              skos:definition "Alteration in the Group of Pictures (I, P, and B frames) compression pattern, indicating that the visual stream was re-encoded."@en ,
                                              "Alteração no padrão de agrupamento de quadros (I, P e B) da compressão de vídeo, indicando que o fluxo visual foi recodificado."@pt .


###  http://example.org/oem#DivergenciaDeResolucaoOuOrientacao
oem:DivergenciaDeResolucaoOuOrientacao rdf:type owl:Class ;
                                       rdfs:subClassOf oem:IndicioDeRecodificacao ;
                                       rdfs:label "Divergência de Resolução ou Orientação"@pt ,
                                                  "Resolution or Orientation Divergence"@en ;
                                       skos:definition "Alteração nas dimensões em pixels (largura e altura) ou na orientação espacial do vídeo em comparação com a gravação de referência."@pt ,
                                                       "Change in pixel dimensions (width and height) or spatial orientation of the video compared to the reference recording."@en .


###  http://example.org/oem#DivergenciaDeTaxaDeQuadros
oem:DivergenciaDeTaxaDeQuadros rdf:type owl:Class ;
                               rdfs:subClassOf oem:IndicioDeRecodificacao ;
                               rdfs:label "Divergência de Taxa de Quadros"@pt ,
                                          "Frame Rate Divergence"@en ;
                               skos:definition "Change in the number of frames displayed per second (fps) relative to the reference original video."@en ,
                                               "Mudança na quantidade de quadros exibidos por segundo (fps) em relação ao vídeo original de referência."@pt .


###  http://example.org/oem#DivergenciaDeTimeBaseVideo
oem:DivergenciaDeTimeBaseVideo rdf:type owl:Class ;
                               rdfs:subClassOf oem:IndicioDeRecodificacao ;
                               rdfs:label "Divergência de Base de Tempo de Vídeo"@pt ,
                                          "Video Time Base Divergence"@en ;
                               skos:definition "Diferença na escala de relógio interno usada para marcar o tempo dos quadros de vídeo no contêiner multimídia."@pt ,
                                               "Difference in the internal clock scale used to timestamp video frames within the multimedia container."@en .


###  http://example.org/oem#EvidenciaComCadeiaQuebrada
oem:EvidenciaComCadeiaQuebrada rdf:type owl:Class ;
                               owl:equivalentClass [ owl:intersectionOf ( oem:EvidenciaMultimidia
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty oem:sofreu ;
                                                                            owl:someValuesFrom oem:TransformacaoNaoDeclarada
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ] ;
                               rdfs:subClassOf oem:EvidenciaMultimidia ;
                               owl:disjointWith oem:EvidenciaIntegra ;
                               rdfs:label "Broken Chain of Custody Evidence"@en ,
                                          "Evidência com Cadeia de Custódia Quebrada"@pt ;
                               skos:definition "Evidência multimídia que sofreu uma transformação comprovadamente desprovida de registro formal na cadeia de custódia."@pt ,
                                               "Multimedia evidence that underwent a transformation proven to lack a formal record in the chain of custody."@en .


###  http://example.org/oem#EvidenciaComConteudoAlterado
oem:EvidenciaComConteudoAlterado rdf:type owl:Class ;
                                 owl:equivalentClass [ owl:intersectionOf ( oem:EvidenciaMultimidia
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty oem:sofreu ;
                                                                              owl:someValuesFrom oem:TransformacaoGenerativa
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ] ;
                                 rdfs:subClassOf oem:EvidenciaMultimidia ;
                                 owl:disjointWith oem:EvidenciaIntegra ;
                                 rdfs:label "Content-Altered Evidence"@en ,
                                            "Evidência com Conteúdo Alterado"@pt ;
                                 skos:definition "Evidência multimídia que sofreu ao menos uma transformação generativa (edição ou síntese de voz ou rosto), alterando o conteúdo informacional que a evidência afirma."@pt ,
                                                 "Multimedia evidence that underwent at least one generative transformation (editing or voice/face synthesis), altering the informational content asserted by the evidence."@en .


###  http://example.org/oem#EvidenciaIntegra
oem:EvidenciaIntegra rdf:type owl:Class ;
                     owl:equivalentClass [ owl:intersectionOf ( oem:EvidenciaMultimidia
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty oem:sofreu ;
                                                                  owl:someValuesFrom oem:TransformacaoPreservadoraDeclarada
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty oem:sofreu ;
                                                                  owl:allValuesFrom oem:TransformacaoPreservadoraDeclarada
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ;
                     rdfs:subClassOf oem:EvidenciaMultimidia ;
                     rdfs:label "Evidência Íntegra"@pt ,
                                "Intact Multimedia Evidence"@en ;
                     skos:definition "Evidência multimídia cujo percurso de custódia está formalmente fechado e que sofreu apenas transformações preservadoras (isomórficas ou homomórficas) devidamente declaradas em registros de custódia."@pt ,
                                     "Multimedia evidence whose custody path is formally closed and that underwent only preserving transformations (isomorphic or homomorphic) duly declared in custody records."@en .


###  http://example.org/oem#EvidenciaMultimidia
oem:EvidenciaMultimidia rdf:type owl:Class ;
                        rdfs:label "Evidência Multimídia"@pt ,
                                   "Multimedia Evidence"@en ;
                        skos:definition "Any audio, image, or video item submitted to forensic examination or custody."@en ,
                                        "Any audio, image, or video recording or artifact submitted to custody and forensic analysis."@en ,
                                        "Qualquer gravação ou artefato de áudio, imagem ou vídeo submetido à custódia e à análise pericial."@pt ,
                                        "Qualquer item de áudio, imagem ou vídeo submetido a exame ou custódia pericial."@pt .


###  http://example.org/oem#ExameENF
oem:ExameENF rdf:type owl:Class ;
             rdfs:subClassOf oem:ExamePericial ;
             rdfs:label "Electrical Network Frequency (ENF) Examination"@en ,
                        "Exame de Frequência da Rede Elétrica (ENF)"@pt ;
             skos:definition "Acoustic forensic examination that checks the presence and continuity of the Brazilian power grid hum (60 Hz and 120 Hz harmonic)."@en ,
                             "Exame pericial acústico que verifica a presença e a continuidade do zumbido da rede elétrica brasileira (60 Hz e harmônico de 120 Hz)."@pt ,
                             "Exame pericial que busca a componente da rede elétrica (60 Hz no Brasil e seu harmônico de 120 Hz) para avaliar estabilidade e eventuais descontinuidades de fase ou frequência."@pt ,
                             "Forensic examination that searches for the power grid component (60 Hz in Brazil and its 120 Hz harmonic) to assess stability and potential phase or frequency discontinuities."@en .


###  http://example.org/oem#ExameMetadadosContainerGOP
oem:ExameMetadadosContainerGOP rdf:type owl:Class ;
                               rdfs:subClassOf oem:ExamePericial ;
                               rdfs:label "Container Metadata and GOP Structure Examination"@en ,
                                          "Exame de Metadados de Contêiner e Estrutura de GOP"@pt ;
                               skos:definition "Exame pericial que compara parâmetros de codificação, contêiner e sequência de quadros (I, P, B) de um vídeo com uma referência conhecida."@pt ,
                                               "Exame pericial que inspeciona cabeçalhos do arquivo de vídeo e a sequência de quadros I, P e B em comparação com uma referência."@pt ,
                                               "Forensic examination comparing encoding parameters, container metadata, and frame sequence (I, P, B) of a video against a known reference."@en ,
                                               "Forensic examination that inspects video file headers and the sequence of I, P, and B frames compared against a reference."@en .


###  http://example.org/oem#ExamePericial
oem:ExamePericial rdf:type owl:Class ;
                  rdfs:subClassOf oem:TransformacaoHomomorfica ;
                  rdfs:label "Exame Pericial"@pt ,
                             "Forensic Examination"@en ;
                  skos:definition "Documented technical forensic procedure that inspects physical, acoustic, or structural properties of multimedia evidence."@en ,
                                  "Documented technical procedure that analyzes signals or metadata of multimedia evidence to produce a forensic report."@en ,
                                  "Procedimento técnico documentado que analisa sinais ou metadados de uma evidência multimídia para produzir um laudo ou relatório analítico."@pt ,
                                  "Procedimento técnico-pericial documentado que inspeciona propriedades físicas, acústicas ou estruturais de uma evidência multimídia."@pt .


###  http://example.org/oem#ExtracaoDeAudio
oem:ExtracaoDeAudio rdf:type owl:Class ;
                    rdfs:subClassOf oem:TransformacaoHomomorfica ;
                    rdfs:label "Audio Extraction"@en ,
                               "Extração de Áudio"@pt ;
                    skos:definition "Homomorphic operation that isolates and decodes the audio track from a video container into an uncompressed audio format while preserving the original sample rate."@en ,
                                    "Homomorphic operation that separates and decodes the audio track of a video into unresampled PCM audio."@en ,
                                    "Operação homomórfica que isola e decodifica a trilha sonora de um contêiner de vídeo para formato de áudio sem compressão com perdas, mantendo a taxa de amostragem original."@pt ,
                                    "Operação homomórfica que separa e decodifica a trilha sonora de um vídeo para áudio PCM sem reamostragem."@pt .


###  http://example.org/oem#ExtracaoDeCurvaENF
oem:ExtracaoDeCurvaENF rdf:type owl:Class ;
                       rdfs:subClassOf oem:TransformacaoHomomorfica ;
                       rdfs:label "ENF Curve Extraction"@en ,
                                  "Extração de Curva ENF"@pt ;
                       skos:definition "Homomorphic operation that isolates the temporal variation of the power grid frequency (60 Hz or 120 Hz) present in the audio."@en ,
                                       "Homomorphic transformation that extracts the Electrical Network Frequency (60 Hz or harmonics) time series from an audio signal."@en ,
                                       "Operação homomórfica que isola a variação temporal da frequência da rede elétrica (60 Hz ou 120 Hz) presente no áudio."@pt ,
                                       "Transformação homomórfica que extrai a série temporal da frequência da rede elétrica (60 Hz ou harmônicos) a partir de um sinal de áudio."@pt .


###  http://example.org/oem#GeracaoDeEspectrograma
oem:GeracaoDeEspectrograma rdf:type owl:Class ;
                           rdfs:subClassOf oem:TransformacaoHomomorfica ;
                           rdfs:label "Geração de Espectrograma"@pt ,
                                      "Spectrogram Generation"@en ;
                           skos:definition "Homomorphic operation that computes and plots the power spectral density of an audio signal over time."@en ,
                                           "Homomorphic transformation that projects an audio signal into the time-frequency domain (power spectral density) without altering the input evidence."@en ,
                                           "Operação homomórfica que calcula e representa graficamente a densidade espectral de potência de um áudio ao longo do tempo."@pt ,
                                           "Transformação homomórfica que projeta um sinal de áudio no domínio tempo-frequência (densidade espectral de potência) sem alterar a evidência de entrada."@pt .


###  http://example.org/oem#InconsistenciaSampleRateTimeBaseAudio
oem:InconsistenciaSampleRateTimeBaseAudio rdf:type owl:Class ;
                                          rdfs:subClassOf oem:IndicioDeRecodificacao ;
                                          rdfs:label "Audio Sample Rate and Time Base Inconsistency"@en ,
                                                     "Inconsistência entre Taxa de Amostragem e Base de Tempo de Áudio"@pt ;
                                          skos:definition "Descompasso interno no contêiner em que a escala de tempo da trilha sonora não coincide com a taxa de amostragem do áudio."@pt ,
                                                          "Internal container mismatch where the audio track time scale does not match the audio sample rate."@en .


###  http://example.org/oem#IndicioDeEdicao
oem:IndicioDeEdicao rdf:type owl:Class ;
                    rdfs:subClassOf oem:AchadoPericial ;
                    rdfs:label "Editing Indicator"@en ,
                               "Indício de Edição"@pt ;
                    skos:definition "Achado técnico que aponta divergência estrutural, acústica ou de codificação compatível com reprocessamento ou edição, sem constituir por si só conclusão de adulteração."@pt ,
                                    "Sinal técnico observado no áudio, vídeo ou metadados que sugere possível reprocessamento ou corte, sem constituir isoladamente prova conclusiva de fraude."@pt ,
                                    "Technical finding pointing to structural, acoustic, or encoding divergence compatible with reprocessing or editing, without constituting by itself a conclusion of tampering."@en ,
                                    "Technical sign observed in audio, video, or metadata suggesting possible reprocessing or splicing, without constituting by itself conclusive proof of fraud."@en .


###  http://example.org/oem#IndicioDeRecodificacao
oem:IndicioDeRecodificacao rdf:type owl:Class ;
                           rdfs:subClassOf oem:IndicioDeEdicao ;
                           rdfs:label "Indício de Recodificação"@pt ,
                                      "Re-encoding Indicator"@en ;
                           skos:definition "Divergence in compression or container parameters indicating that the video or audio was saved or recompressed after original capture."@en ,
                                           "Divergência nos parâmetros de compressão ou contêiner que aponta que o vídeo ou áudio foi salvo ou comprimido novamente após a captura original."@pt ,
                                           "Indício técnico de que o arquivo de vídeo ou áudio passou por nova etapa de compressão, mudança de resolução, taxa de quadros, estrutura de GOP ou taxa de bits."@pt ,
                                           "Technical indicator that the video or audio file underwent a new compression stage, resolution change, frame rate change, GOP structure alteration, or bitrate change."@en .


###  http://example.org/oem#RecodificacaoDeTransmissao
oem:RecodificacaoDeTransmissao rdf:type owl:Class ;
                               rdfs:subClassOf oem:Transformacao ;
                               rdfs:label "Recodificação de Transmissão"@pt ,
                                          "Transmission Re-encoding"@en ;
                               skos:definition "Lossy recompression and metadata stripping automatically applied by messaging applications or sharing platforms."@en ,
                                               "Recompressão com perdas e remoção de metadados aplicada automaticamente por aplicativos de mensageria ou plataformas de compartilhamento."@pt .


###  http://example.org/oem#RegistroDeCustodia
oem:RegistroDeCustodia rdf:type owl:Class ;
                       rdfs:label "Custody Record"@en ,
                                  "Registro de Custódia"@pt ;
                       skos:definition "Assento formal na cadeia de custódia que documenta quem realizou determinada transformação ou manuseio, quando e sob quais garantias."@pt ,
                                       "Document or formal entry in the chain of custody attesting the execution of a transformation by an identified agent at a specific date and time."@en ,
                                       "Documento ou entrada formal na cadeia de custódia que atesta a execução de uma transformação por um agente identificado em data e hora determinadas."@pt ,
                                       "Formal entry in the chain of custody documenting who performed a given transformation or handling, when, and under which guarantees."@en .


###  http://example.org/oem#Transformacao
oem:Transformacao rdf:type owl:Class ;
                  rdfs:label "Transformation"@en ,
                             "Transformação"@pt ;
                  skos:definition "Operação técnica ou manuseio aplicado a uma evidência multimídia que produz uma cópia, derivado ou modificação."@pt ,
                                  "Operação técnica ou manuseio aplicado sobre uma evidência multimídia que gera um novo artefato ou estado."@pt ,
                                  "Technical operation or handling applied to multimedia evidence producing a new artifact or state."@en ,
                                  "Technical operation or handling applied to multimedia evidence that produces a copy, derivative, or modification."@en .


###  http://example.org/oem#TransformacaoDeclarada
oem:TransformacaoDeclarada rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( oem:Transformacao
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty oem:registradaEm ;
                                                                        owl:someValuesFrom oem:RegistroDeCustodia
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf oem:Transformacao ;
                           owl:disjointWith oem:TransformacaoNaoDeclarada ;
                           rdfs:label "Declared Transformation"@en ,
                                      "Transformação Declarada"@pt ;
                           skos:definition "Transformation that has a formal record in the chain of custody attested by an identified agent."@en ,
                                           "Transformação que possui registro formal na cadeia de custódia atestado por um agente identificado."@pt .


###  http://example.org/oem#TransformacaoGenerativa
oem:TransformacaoGenerativa rdf:type owl:Class ;
                            rdfs:subClassOf oem:Transformacao ;
                            owl:disjointWith oem:TransformacaoPreservadora ;
                            rdfs:label "Generative Transformation"@en ,
                                       "Transformação Generativa"@pt ;
                            skos:definition "Editing, splicing, or neural synthesis operation (such as voice or face deepfake) that introduces or modifies semantic content in the evidence."@en ,
                                            "Operação de edição, montagem ou síntese neural (como deepfake de voz ou rosto) que introduz ou modifica conteúdo semântico na evidência."@pt .


###  http://example.org/oem#TransformacaoHomomorfica
oem:TransformacaoHomomorfica rdf:type owl:Class ;
                             rdfs:subClassOf oem:Transformacao ,
                                             oem:TransformacaoPreservadora ;
                             rdfs:label "Homomorphic Transformation"@en ,
                                        "Transformação Homomórfica"@pt ;
                             skos:definition "Controlled analytical reduction (such as unresampled PCM audio extraction, spectrogram generation, or ENF curve extraction) that projects signal properties without inventing content."@en ,
                                             "Controlled reductive transformation (such as unresampled audio extraction, spectrogram generation, or ENF curve extraction) that preserves relevant forensic properties without introducing synthetic content."@en ,
                                             "Redução analítica controlada (como extração de áudio PCM sem reamostragem, geração de espectrograma ou extração de curva de ENF) que projeta propriedades do sinal sem inventar conteúdo."@pt ,
                                             "Transformação redutora controlada (como extração de áudio sem reamostragem, geração de espectrograma ou extração de curva ENF) que preserva as propriedades periciais relevantes sem introduzir conteúdo sintético."@pt .


###  http://example.org/oem#TransformacaoIsomorfica
oem:TransformacaoIsomorfica rdf:type owl:Class ;
                            rdfs:subClassOf oem:Transformacao ,
                                            oem:TransformacaoPreservadora ;
                            rdfs:label "Isomorphic Transformation"@en ,
                                       "Transformação Isomórfica"@pt ;
                            skos:definition "Cópia forense que mantém exatamente a mesma sequência de bits do arquivo de origem, atestada pela coincidência do hash criptográfico."@pt ,
                                            "Forensic copy that keeps the exact same bit sequence as the source file, attested by cryptographic hash equality."@en ,
                                            "Transformation that strictly preserves the bit sequence of the original evidence, proven by cryptographic hash equality."@en ,
                                            "Transformação que preserva integralmente a sequência de bits da evidência original, comprovada pela igualdade do valor de hash criptográfico."@pt .


###  http://example.org/oem#TransformacaoNaoDeclarada
oem:TransformacaoNaoDeclarada rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( oem:Transformacao
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty oem:registradaEm ;
                                                                           owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
                                                                           owl:onClass oem:RegistroDeCustodia
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf oem:Transformacao ;
                              rdfs:label "Transformação Não Declarada"@pt ,
                                         "Undeclared Transformation"@en ;
                              skos:definition "Transformation for which the absence of any record in the chain of custody has been formally established."@en ,
                                              "Transformação para a qual se constatou formalmente a inexistência de qualquer registro na cadeia de custódia."@pt .


###  http://example.org/oem#TransformacaoPreservadora
oem:TransformacaoPreservadora rdf:type owl:Class ;
                              owl:equivalentClass [ rdf:type owl:Class ;
                                                    owl:unionOf ( oem:TransformacaoHomomorfica
                                                                  oem:TransformacaoIsomorfica
                                                                )
                                                  ] ;
                              rdfs:subClassOf oem:Transformacao ;
                              rdfs:label "Preserving Transformation"@en ,
                                         "Transformação Preservadora"@pt ;
                              skos:definition "Transformation that preserves the evidentiary integrity of the item by being either isomorphic (hash-verified bit-by-bit copy) or homomorphic (controlled analytical reduction)."@en ,
                                              "Transformação que preserva a integridade probatória da evidência por ser isomórfica (cópia bit a bit verificada por hash) ou homomórfica (redução analítica controlada)."@pt .


###  http://example.org/oem#TransformacaoPreservadoraDeclarada
oem:TransformacaoPreservadoraDeclarada rdf:type owl:Class ;
                                       owl:equivalentClass [ owl:intersectionOf ( oem:TransformacaoDeclarada
                                                                                  oem:TransformacaoPreservadora
                                                                                ) ;
                                                             rdf:type owl:Class
                                                           ] ;
                                       rdfs:subClassOf oem:TransformacaoDeclarada ,
                                                       oem:TransformacaoPreservadora ;
                                       rdfs:label "Declared Preserving Transformation"@en ,
                                                  "Transformação Preservadora Declarada"@pt ;
                                       skos:definition "Transformation that is simultaneously preserving (isomorphic or homomorphic) and formally recorded in the chain of custody."@en ,
                                                       "Transformação simultaneamente preservadora (isomórfica ou homomórfica) e formalmente registrada na cadeia de custódia."@pt .


###  http://example.org/oem#ValorHash
oem:ValorHash rdf:type owl:Class ;
              rdfs:label "Hash Value"@en ,
                         "Valor de Hash"@pt ;
              skos:definition "Cryptographic digest computed over a file to prove its binary content remained unchanged."@en ,
                              "Código alfanumérico de tamanho fixo (como SHA-256) que funciona como impressão digital única dos bytes de um arquivo."@pt ,
                              "Fixed-length alphanumeric code (such as SHA-256) acting as a unique digital fingerprint of a file's bytes."@en ,
                              "Resumo criptográfico calculado sobre um arquivo para comprovar que seu conteúdo binário permaneceu inalterado."@pt .


