@prefix oem: <http://example.org/oem#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/oem/cases/caso_c> a owl:Ontology ;
    owl:imports <http://example.org/oem> ;
    rdfs:label "Caso C - Versão Recodificada por Aplicativo de Mensagem sem Registro de Custódia"@pt ,
               "Case C - Messaging App Re-encoded Version without Custody Record"@en ;
    skos:definition "Instâncias e exames periciais do Caso C: vídeo recodificado por transmissão em aplicativo de mensageria sem registro de custódia (registradaEm max 0 RegistroDeCustodia)."@pt ,
                    "Instances and forensic examinations for Case C: video re-encoded by messaging app transmission lacking a custody record (registradaEm max 0 RegistroDeCustodia)."@en .

# =============================================================================
# Agente e Evidências de Entrada e Saída (Caso C)
# =============================================================================

oem:Agente_Perito a owl:NamedIndividual , oem:Agente ;
    rdfs:label "Agente (perito)"@pt , "Agente (perito)"@en ;
    oem:nomeAgente "Agente (perito)"^^xsd:string .

oem:Evidencia_Original_1_Work a owl:NamedIndividual , oem:EvidenciaMultimidia ;
    rdfs:label "Vídeo Original 1 (Cópia de Referência - Caso A)"@pt ,
               "Original Video 1 (Reference Copy - Case A)"@en ;
    oem:caminhoArquivo "data/work/caso_a/video_original_1.mp4"^^xsd:string ;
    oem:tamanhoBytes 1718872 .

oem:Evidencia_Recodificado_Mensageiro_1_Work a owl:NamedIndividual , oem:EvidenciaMultimidia ;
    rdfs:label "Vídeo Recodificado por Aplicativo de Mensagem 1 (Caso C)"@pt ,
               "Messaging App Re-encoded Video 1 (Case C)"@en ;
    oem:caminhoArquivo "data/work/caso_c/video_recodificado_mensageiro_1.mp4"^^xsd:string ;
    oem:tamanhoBytes 925087 ;
    oem:sofreu oem:TransmissaoMensageiro_video_1 ;
    oem:temValorHash oem:Hash_video_recodificado_mensageiro_1 .

oem:Hash_video_recodificado_mensageiro_1 a owl:NamedIndividual , oem:ValorHash ;
    rdfs:label "Hash SHA-256 de video_recodificado_mensageiro_1.mp4"@pt ,
               "SHA-256 Hash of video_recodificado_mensageiro_1.mp4"@en ;
    oem:algoritmoHash "SHA-256"^^xsd:string ;
    oem:valorHashHex "361fa834338c76bbc239589c46cc896cd0c524c0fe63a5d5a93f22728a00f3fd"^^xsd:string ;
    oem:dataHora "2026-11-17T12:59:56-03:00"^^xsd:dateTime .

# =============================================================================
# Recodificação de Transmissão SEM Registro de Custódia (registradaEm max 0)
# =============================================================================

oem:TransmissaoMensageiro_video_1 a owl:NamedIndividual , oem:RecodificacaoDeTransmissao , [
        a owl:Restriction ;
        owl:onProperty oem:registradaEm ;
        owl:maxQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
        owl:onClass oem:RegistroDeCustodia
    ] ;
    rdfs:label "Recodificação por Aplicativo de Mensagem sem Registro de Custódia"@pt ,
               "Messaging App Re-encoding without Custody Record"@en ;
    oem:temEntrada oem:Evidencia_Original_1_Work ;
    oem:temSaida oem:Evidencia_Recodificado_Mensageiro_1_Work ;
    oem:parametrosTransformacao "Recodificação com perdas (H.264 Main@L3.1, CRF 28, 476x848, B-frames=2, AAC 96 kbps @ 44100 Hz) e remoção de metadados (-map_metadata -1) sem registro na cadeia de custódia"^^xsd:string ;
    oem:dataHora "2026-11-17T12:59:56-03:00"^^xsd:dateTime .

# =============================================================================
# Extração de Áudio, Espectrograma, Exame ENF e Exame de GOP do Caso C
# =============================================================================

