@prefix oem: <http://example.org/oem#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/oem/cases/caso_b> a owl:Ontology ;
    owl:imports <http://example.org/oem> ;
    rdfs:label "Caso B - Evidências Sintéticas (Deepfake), Aquisição Isomórfica e Extração de Áudio"@pt ,
               "Case B - Synthetic Evidence (Deepfake), Isomorphic Acquisition, and Audio Extraction"@en ;
    skos:definition "Instâncias e registros de cadeia de custódia referentes ao Caso B (aquisição isomórfica verificada por hash SHA-256 dos vídeos sintéticos e extração homomórfica das trilhas de áudio em PCM 16-bit)."@pt ,
                    "Instances and chain of custody records for Case B (SHA-256 hash-verified isomorphic acquisition of synthetic videos and homomorphic extraction of 16-bit PCM audio tracks)."@en .

# =============================================================================
# Transformações Generativas (Síntese Neural / Deepfake) que deram origem às Matrizes do Caso B
# =============================================================================

oem:SinteseDeepfake_1_1 a owl:NamedIndividual , oem:TransformacaoGenerativa ;
    rdfs:label "Síntese Neural (Deepfake) geradora de video_sintetico_1_1.mp4"@pt ,
               "Neural Synthesis (Deepfake) generating video_sintetico_1_1.mp4"@en ;
    oem:temSaida oem:Evidencia_Sintetico_1_1_Raw , oem:Evidencia_Sintetico_1_1_Work .

oem:SinteseDeepfake_1_2 a owl:NamedIndividual , oem:TransformacaoGenerativa ;
    rdfs:label "Síntese Neural (Deepfake) geradora de video_sintetico_1_2.mp4"@pt ,
               "Neural Synthesis (Deepfake) generating video_sintetico_1_2.mp4"@en ;
    oem:temSaida oem:Evidencia_Sintetico_1_2_Raw , oem:Evidencia_Sintetico_1_2_Work .

oem:SinteseDeepfake_2_1 a owl:NamedIndividual , oem:TransformacaoGenerativa ;
    rdfs:label "Síntese Neural (Deepfake) geradora de video_sintetico_2_1.mp4"@pt ,
               "Neural Synthesis (Deepfake) generating video_sintetico_2_1.mp4"@en ;
    oem:temSaida oem:Evidencia_Sintetico_2_1_Raw , oem:Evidencia_Sintetico_2_1_Work .

oem:SinteseDeepfake_2_2 a owl:NamedIndividual , oem:TransformacaoGenerativa ;
    rdfs:label "Síntese Neural (Deepfake) geradora de video_sintetico_2_2.mp4"@pt ,
               "Neural Synthesis (Deepfake) generating video_sintetico_2_2.mp4"@en ;
    oem:temSaida oem:Evidencia_Sintetico_2_2_Raw , oem:Evidencia_Sintetico_2_2_Work .

# =============================================================================
# Declarações de Vocabulário (OWL 2 DL Declarations)
# =============================================================================

oem:EvidenciaMultimidia a owl:Class ;
    rdfs:label "Evidência Multimídia"@pt , "Multimedia Evidence"@en ;
    skos:definition "Qualquer item de áudio, imagem ou vídeo submetido a exame ou custódia pericial."@pt ,
                    "Any audio, image, or video item submitted to forensic examination or custody."@en .

oem:Transformacao a owl:Class ;
    rdfs:label "Transformação"@pt , "Transformation"@en ;
    skos:definition "Operação técnica ou manuseio aplicado sobre uma evidência multimídia que gera um novo artefato ou estado."@pt ,
                    "Technical operation or handling applied to multimedia evidence producing a new artifact or state."@en .

oem:TransformacaoIsomorfica a owl:Class ;
    rdfs:subClassOf oem:Transformacao ;
    rdfs:label "Transformação Isomórfica"@pt , "Isomorphic Transformation"@en ;
    skos:definition "Transformação que preserva integralmente a sequência de bits da evidência original, comprovada pela igualdade do valor de hash criptográfico."@pt ,
                    "Transformation that strictly preserves the bit sequence of the original evidence, proven by cryptographic hash equality."@en .

oem:TransformacaoHomomorfica a owl:Class ;
    rdfs:subClassOf oem:Transformacao ;
    rdfs:label "Transformação Homomórfica"@pt , "Homomorphic Transformation"@en ;
    skos:definition "Transformação redutora controlada (como extração de áudio sem reamostragem, geração de espectrograma ou extração de curva ENF) que preserva as propriedades periciais relevantes sem introduzir conteúdo sintético."@pt ,
                    "Controlled reductive transformation (such as unresampled audio extraction, spectrogram generation, or ENF curve extraction) that preserves relevant forensic properties without introducing synthetic content."@en .

oem:ExtracaoDeAudio a owl:Class ;
    rdfs:subClassOf oem:TransformacaoHomomorfica ;
    rdfs:label "Extração de Áudio"@pt , "Audio Extraction"@en ;
    skos:definition "Operação homomórfica que isola e decodifica a trilha sonora de um contêiner de vídeo para formato de áudio sem compressão com perdas, mantendo a taxa de amostragem original."@pt ,
                    "Homomorphic operation that isolates and decodes the audio track from a video container into an uncompressed audio format while preserving the original sample rate."@en .

oem:ValorHash a owl:Class ;
    rdfs:label "Valor de Hash"@pt , "Hash Value"@en ;
    skos:definition "Resumo criptográfico calculado sobre um arquivo para comprovar que seu conteúdo binário permaneceu inalterado."@pt ,
                    "Cryptographic digest computed over a file to prove its binary content remained unchanged."@en .

oem:RegistroDeCustodia a owl:Class ;
    rdfs:label "Registro de Custódia"@pt , "Custody Record"@en ;
    skos:definition "Assento formal na cadeia de custódia que documenta quem realizou determinada transformação ou manuseio, quando e sob quais garantias."@pt ,
                    "Formal entry in the chain of custody documenting who performed a given transformation or handling, when, and under which guarantees."@en .

oem:Agente a owl:Class ;
    rdfs:label "Agente"@pt , "Agent"@en ;
    skos:definition "Pessoa ou sistema responsável por executar ou atestar um ato na cadeia de custódia."@pt ,
                    "Person or system responsible for executing or attesting an act in the chain of custody."@en .

oem:temEntrada a owl:ObjectProperty ;
    rdfs:label "tem entrada"@pt , "has input"@en .

oem:temSaida a owl:ObjectProperty ;
    rdfs:label "tem saída"@pt , "has output"@en .

oem:verificadaPor a owl:ObjectProperty ;
    rdfs:label "verificada por"@pt , "verified by"@en .

oem:registradaEm a owl:ObjectProperty ;
    rdfs:label "registrada em"@pt , "recorded in"@en .

oem:documentaTransformacao a owl:ObjectProperty ;
    rdfs:label "documenta transformação"@pt , "documents transformation"@en .

oem:atestadoPor a owl:ObjectProperty ;
    rdfs:label "atestado por"@pt , "attested by"@en .

oem:temValorHash a owl:ObjectProperty ;
    rdfs:label "tem valor de hash"@pt , "has hash value"@en .

oem:algoritmoHash a owl:DatatypeProperty ;
    rdfs:label "algoritmo de hash"@pt , "hash algorithm"@en .

oem:valorHashHex a owl:DatatypeProperty ;
    rdfs:label "valor hexadecimal do hash"@pt , "hexadecimal hash value"@en .

oem:dataHora a owl:DatatypeProperty ;
    rdfs:label "data e hora"@pt , "date and time"@en .

oem:caminhoArquivo a owl:DatatypeProperty ;
    rdfs:label "caminho do arquivo"@pt , "file path"@en .

oem:tamanhoBytes a owl:DatatypeProperty ;
    rdfs:label "tamanho em bytes"@pt , "size in bytes"@en .

oem:somenteLeitura a owl:DatatypeProperty ;
    rdfs:label "somente leitura"@pt , "read-only"@en .

oem:nomeAgente a owl:DatatypeProperty ;
    rdfs:label "nome do agente"@pt , "agent name"@en .

oem:comandoExecutado a owl:DatatypeProperty ;
    rdfs:label "comando executado"@pt , "executed command"@en .

oem:versaoFerramenta a owl:DatatypeProperty ;
    rdfs:label "versão da ferramenta"@pt , "tool version"@en .

oem:parametrosTransformacao a owl:DatatypeProperty ;
    rdfs:label "parâmetros da transformação"@pt , "transformation parameters"@en .

oem:metodoDownmixMono a owl:DatatypeProperty ;
    rdfs:label "método de conversão para mono"@pt , "mono downmix method"@en .

oem:taxaAmostragemHz a owl:DatatypeProperty ;
    rdfs:label "taxa de amostragem (Hz)"@pt , "sample rate (Hz)"@en .

oem:numeroCanais a owl:DatatypeProperty ;
    rdfs:label "número de canais"@pt , "number of channels"@en .

# =============================================================================
# Agente Responsável (Perito / Pesquisador)
# =============================================================================

oem:Agente_Perito a owl:NamedIndividual , oem:Agente ;
    rdfs:label "Agente (perito)"@pt , "Agente (perito)"@en ;
    oem:nomeAgente "Agente (perito)"^^xsd:string .

