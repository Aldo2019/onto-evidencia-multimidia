# =============================================================================
# 3. PNG Policy: Exclude all PNGs by default, allow ONLY Conjunto 1 in results/,
#    and explicitly block all Conjunto 2 PNGs (Video_original_2, video_sintetico_2_*)
# =============================================================================
*.png
*.PNG
!results/**/*.png
!results/**/*.PNG

# Block Conjunto 2 visual/derived PNG artifacts (third-party platform video set)
results/**/*Video_original_2*.png
results/**/*video_original_2*.png
results/**/*video_sintetico_2_*.png
results/**/*Video_sintetico_2_*.png

